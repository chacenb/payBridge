# Preprod configuration for compose.preprod.yaml (pulls a pre-built image,
# never builds from source -- the target host does not need this
# repository's code). Copy this file to .env.preprod on the preprod host
# (NOT .env -- that name is reserved for local dev) and replace every
# REPLACE_ME_* value. Reference it explicitly:
# docker compose --env-file .env.preprod -f compose.preprod.yaml ...
# Never commit the resulting .env.preprod.

# Backend image repository (NO tag) -- the tag comes from the VERSION file
# next to deploy.sh, shared with the frontend. Only used by
# compose.preprod.yaml -- ignored by compose.yaml (builds from source).
PAYBRIDGE_IMAGE=sahelys/paybridge-standalone

# Frontend image repository (NO tag). Same rule as PAYBRIDGE_IMAGE above --
# pre-built and pinned by the shared VERSION file, never built on this host.
PAYBRIDGE_FRONT_IMAGE=sahelys/paybridge-front

# Port the app listens on INSIDE the container.
SERVER_PORT=9000

# HOST-side port that maps to SERVER_PORT. Must match whatever is
# registered with Moov as the callback address (see MOMO_RESULT_BASE_URL
# below) -- keep this equal to SERVER_PORT unless you specifically need
# the externally reachable port to differ.
PAYBRIDGE_PORT=9000

# HOST-side port that maps to the frontend's nginx container (port 80 inside).
PAYBRIDGE_FRONT_PORT=9001

# Path the Moov Money callback endpoint listens on. The app sends this
# same path to Moov as part of MOMO_RESULT_BASE_URL below -- one source
# of truth, not duplicated.
PAYBRIDGE_CALLBACK_PATH=/sahelyspay/payment/callback

# Reserved for the Airtel Money callback endpoint. Currently unused --
# no Airtel callback route is wired up yet -- but declared like every
# other config value rather than left undefinable.
PAYBRIDGE_CALLBACK_AIRTEL_PATH=/sahelyspay/payment/callback/airtel

# This instance's own publicly reachable base URL, used to build the paymentUrl
# returned to clients from POST /api/paybridge/v1/submit-payment-request.
PAYBRIDGE_PUBLIC_BASE_URL=REPLACE_ME_http://<this-host-public-address>:9000

# Database values. Use a strong, unique password for this environment.
POSTGRES_DB=paybridge
POSTGRES_USER=paybridge
POSTGRES_PASSWORD=REPLACE_ME_strong_password_for_this_environment

# Host port for PostgreSQL. Only used by compose.yaml for local development
# inspection -- ignored by compose.preprod.yaml, which never publishes the
# DB port. Leave as default/unset in any shared or production environment.
POSTGRES_PORT=unused-for-preprod

# Moov Money operator configuration for this environment specifically -- do
# not reuse credentials across environments, and do not commit actual values.
MOMO_THIRD_PARTY_ID=REPLACE_ME_third_party_id
MOMO_PASSWORD=REPLACE_ME_momo_password
# This host's own publicly reachable base address (no path) -- PAYBRIDGE_CALLBACK_PATH
# above is appended automatically to build the full ResultURL sent to Moov. Must match
# what is registered with Moov for this environment.
MOMO_RESULT_BASE_URL=REPLACE_ME_http://<this-host-public-address>:9000
MOMO_KEY_OWNER=1
MOMO_CHANNEL_CODE=1010
MOMO_BASE_URL=REPLACE_ME_https://<moov-endpoint-for-this-environment>
MOMO_PAYMENT_ENDPOINT=/APIRequestMgrService
MOMO_SYNC_ENDPOINT=/SYNCAPIRequestMgrService

# Temporary integration setting matching the current curl -k scripts.
MOOV_TLS_VERIFY=false

# Allow this container to use at most 512 MB of RAM.
CONTAINER_MEMORY_LIMIT=512m

# Host folder where the back writes its logs (bind-mounted to /app/logs). Created by
# deploy.sh when missing. Persistent across releases and readable from the host OS.
PAYBRIDGE_LOGS_DIR=/mnt/PAYBRIDGELUN/LOGS

# Application logging (see src/main/resources/log4j2.xml). Rotated archives older
# than DELETE_LOGS_OLDER_THAN_X_DAYS are deleted; a file also rotates past LOG_FILE_SIZE.
LOGFILE_NAME=paybridge.log
DELETE_LOGS_OLDER_THAN_X_DAYS=10
LOG_FILE_SIZE="100 MB"
# trace | debug | info | warn | error -- level of the com.sahelys.payBridge loggers.
APP_LOG_LEVEL=info
