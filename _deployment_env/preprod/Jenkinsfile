pipeline {
  agent any
  options { disableConcurrentBuilds(); timestamps() }

  environment {
    GITLAB_BACKEND_REPO     = 'https://luga01.dyndns.org/git/r-d/paybridge/paybridge-back.git'
    GITLAB_FRONTEND_REPO    = 'https://luga01.dyndns.org/git/r-d/paybridge/paybridge-front.git'
    GITLAB_REPO_BRANCH      = 'develop'
    
    JENKINS_TO_GITLAB_CREDENTIALS   = 'uname_pass_credential_conTo_SA_gitLab'
    JENKINS_TO_DOCKER_CREDENTIALS   = 'uname_pass_credential_conTo_SA_docker'
    JENKINS_TO_SA_AWS_QRPAY_SITIMOBILE_CREDENTIALS      = 'uname_Key_credential_conTo_AWS_qrpay_sitimobile_com'

    BACK_IMAGE    = 'sahelys/paybridge-standalone'
    FRONT_IMAGE   = 'sahelys/paybridge-front'

    DEPLOY_DIR    = 'backend/_deployment_env/preprod'

    PREPROD_HOST        = 'rocky@qrpay.sitimobile.com'
    PREPROD_HOST_DIR    = '/home/rocky/payBridgeStandalone/'
  }

  stages {

    stage('Checkout backend') {
      steps {
        dir('backend') {
          git url: env.GITLAB_BACKEND_REPO, branch: env.GITLAB_REPO_BRANCH, credentialsId: env.JENKINS_TO_GITLAB_CREDENTIALS
        }
      }
    }

    stage('Checkout frontend') {
      steps {
        dir('frontend') {
          git url: env.GITLAB_FRONTEND_REPO, branch: env.GITLAB_REPO_BRANCH, credentialsId: env.JENKINS_TO_GITLAB_CREDENTIALS
        }
      }
    }

    stage('Read version') {
      steps {
        script {
          env.VERSION = readFile('backend/VERSION').trim()
          echo "Releasing ${env.VERSION}"
        }
      }
    }

    // Free the disk on the Jenkins agent: drop every image of the PREVIOUS
    // builds (all tags of both repositories) plus dangling layers before
    // building the next ones. Releases live in the registry, so nothing is lost.
    // Best-effort (`|| true`): a missing image or one still in use must not fail the build.
    stage('Clean previous images') {
      steps {
        sh '''
          docker images --format '{{.Repository}}:{{.Tag}}' | grep -E "^($BACK_IMAGE|$FRONT_IMAGE):" | xargs -r docker rmi -f || true
          docker image prune -f || true
        '''
      }
    }

    stage('Build backend image') {
      steps { sh 'docker build -t $BACK_IMAGE:$VERSION -t $BACK_IMAGE:latest backend' }
    }

    stage('Build frontend image') {
      steps { sh 'docker build -t $FRONT_IMAGE:$VERSION -t $FRONT_IMAGE:latest frontend' }
    }

    // Both images are built before either is pushed, so a failed build can't
    // leave a half-published release in the registry.

    stage('Push images') {
      steps {
        withCredentials([usernamePassword(credentialsId: env.JENKINS_TO_DOCKER_CREDENTIALS, usernameVariable: 'U', passwordVariable: 'P')]) {
          sh '''
            echo "$P" | docker login -u "$U" --password-stdin
            docker push $BACK_IMAGE:$VERSION  && docker push $BACK_IMAGE:latest
            docker push $FRONT_IMAGE:$VERSION && docker push $FRONT_IMAGE:latest
          '''
        }
      }
    }

    // Only what the app needs is shipped: compose.preprod.yaml and VERSION (from the backend repo root).
    // deploy.sh / logs.sh / .env.preprod already live on the server (installed
    // once by hand, never overwritten by CI); the pipeline just runs deploy.sh,
    // which pulls the pinned images, restarts the stack and fails (non-zero) if
    // a health check does not pass.
    stage('Deploy to preprod') {
      steps {
        sshagent([env.JENKINS_TO_SA_AWS_QRPAY_SITIMOBILE_CREDENTIALS]) {
          sh '''
            scp -o StrictHostKeyChecking=accept-new $DEPLOY_DIR/compose.preprod.yaml backend/VERSION $PREPROD_HOST:$PREPROD_HOST_DIR/
            ssh -o StrictHostKeyChecking=accept-new $PREPROD_HOST "cd $PREPROD_HOST_DIR && sudo ./deploy.sh"
          '''
        }
      }
    }
  }
}
