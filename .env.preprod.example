# Preprod configuration for compose.preprod.yaml (pulls a pre-built image, never
# builds from source -- the target host does not need this repository's code).
# Copy this file to .env.preprod on the preprod host (NOT .env -- that name is
# reserved for local dev) and replace every REPLACE_ME_* value. Reference it
# explicitly: docker compose --env-file .env.preprod -f compose.preprod.yaml ...
# Never commit the resulting .env.preprod.

# Image to pull, e.g. registry.example.com/sahelys/paybridge:1.0.0
PAYBRIDGE_IMAGE=REPLACE_ME_registry/paybridge:REPLACE_ME_tag

# Port the app listens on INSIDE the container.
SERVER_PORT=9000

# HOST-side port that maps to SERVER_PORT for this host. Must match whatever
# is registered with Moov (see MOMO_RESULT_URL below) -- keep this equal to
# SERVER_PORT unless you specifically need the externally reachable port to
# differ.
PAYBRIDGE_PORT=9000

# Database values. Use a strong, unique password for this environment.
POSTGRES_DB=paybridge
POSTGRES_USER=paybridge
POSTGRES_PASSWORD=REPLACE_ME_strong_password_for_this_environment

# Host port for PostgreSQL. Only used by the local dev compose.yaml -- ignored
# by compose.preprod.yaml, which never publishes the DB port. Leave as-is.
POSTGRES_PORT=unused-for-preprod

# Moov Money operator configuration for THIS environment specifically -- do not reuse
# local/dev credentials, and do not commit actual values.
MOMO_THIRD_PARTY_ID=REPLACE_ME_third_party_id
MOMO_PASSWORD=REPLACE_ME_momo_password
# Must be this host's own publicly reachable address, matching what is registered
# with Moov for this environment.
MOMO_RESULT_URL=REPLACE_ME_http://<this-host-public-address>:9000/sahelyspay/payment/callback
MOMO_KEY_OWNER=1
MOMO_CHANNEL_CODE=1010
MOMO_BASE_URL=REPLACE_ME_https://<moov-endpoint-for-this-environment>
MOMO_PAYMENT_ENDPOINT=/APIRequestMgrService
MOMO_SYNC_ENDPOINT=/SYNCAPIRequestMgrService

# Temporary integration setting matching the current curl -k scripts.
MOOV_TLS_VERIFY=false
