# Image reference to pull instead of building locally. Only used by
# compose.preprod.yaml -- ignored by the local dev compose.yaml, which always
# builds from source. Leave as-is for local dev.
PAYBRIDGE_IMAGE=unused-for-local-dev

# Port the app listens on INSIDE the container.
SERVER_PORT=9000

# HOST-side port that maps to SERVER_PORT. Port 9000 matches the existing
# Moov callback configuration -- keep this equal to SERVER_PORT unless you
# specifically need the externally reachable port to differ.
PAYBRIDGE_PORT=9000

# Database values. Use a strong, unique password in your untracked .env file.
POSTGRES_DB=paybridge
POSTGRES_USER=paybridge
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Host port for PostgreSQL. Exposed for local development inspection only;
# leave unset/default in any shared or production environment.
POSTGRES_PORT=5432

# Moov Money operator configuration. Do not commit actual values.
MOMO_THIRD_PARTY_ID=
MOMO_PASSWORD=
MOMO_RESULT_URL=
MOMO_KEY_OWNER=1
MOMO_CHANNEL_CODE=1010
MOMO_BASE_URL=
MOMO_PAYMENT_ENDPOINT=/APIRequestMgrService
MOMO_SYNC_ENDPOINT=/SYNCAPIRequestMgrService

# Temporary integration setting matching the current curl -k scripts.
MOOV_TLS_VERIFY=false
